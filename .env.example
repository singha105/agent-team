# Anthropic API key. Required. Read from the environment only — never commit a real key.
ANTHROPIC_API_KEY=

# Path to the SQLite database file (relative to repo root).
AGENTTEAM_DB_PATH=data/agentteam.db

# Root of the agent sandbox (relative to repo root).
AGENTTEAM_WORKSPACE_ROOT=workspace

# Only set this when AgentTeam itself runs inside a container (docker-compose).
# The sandbox's bind mount is resolved by the HOST Docker daemon, so it must
# name a path on the host rather than the path this process sees. Leave empty
# when running on the host. docker-compose.yml sets it for you.
AGENTTEAM_HOST_WORKSPACE_ROOT=

# Sandbox execution mode: "docker" (isolated container) or "subprocess" (host process, weaker boundary).
AGENTTEAM_SANDBOX_MODE=docker

# Container image used for docker-mode command execution.
AGENTTEAM_SANDBOX_IMAGE=agentteam-runtime:latest

# Per-command wall-clock timeout in seconds.
AGENTTEAM_COMMAND_TIMEOUT_SECONDS=30

# Allow the sandbox container to reach the network (pip/npm installs). Off by default.
AGENTTEAM_SANDBOX_NETWORK=false

# Budget ceilings enforced per task.
AGENTTEAM_MAX_ITERATIONS=25
AGENTTEAM_MAX_TOKENS_PER_TASK=500000
AGENTTEAM_MAX_AGENT_HOPS=10

# Log level: DEBUG | INFO | WARNING | ERROR
AGENTTEAM_LOG_LEVEL=INFO
